<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meteo_app"
        android:textSize="24sp"
        android:layout_margin="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Button
        android:id="@+id/btnHttpURLConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/HttpURLConnection"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />


    <Button
        android:id="@+id/btnOkHttp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/OkHttp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnHttpURLConnection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/btnHttpsSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/HttpYCertificados"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnOkHttp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <Button
        android:id="@+id/btnEfficiency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Eficiencia"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnHttpsSecurity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/btnWeatherIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/WeatherIcons"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnEfficiency"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>