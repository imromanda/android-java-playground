<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- NUEVO: estilo para textos informativos (6.9.1) -->
    <style name="InfoTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/info_text_default</item>
        <item name="android:padding">8dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <!-- NUEVO: estilo para botones principales (6.9.1) -->
    <style name="PrimaryButtonStyle">
        <item name="android:backgroundTint">@color/purple_500</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- NUEVO: estilo para textos destacados - Bold e italic (6.9.3) -->
    <style name="InfoTextStyleHighlight">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/info_text_highlight</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <!-- NUEVO: estilo Material para botones principales (6.10.3) -->
    <style name="PrimaryMaterialButtonStyle" parent="Widget.Material3.Button">
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/purple_500</item>
    </style>


    <style name="PrimaryMaterialButtonStyleAlt" parent="Widget.Material3.Button">
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:backgroundTint">@color/teal_200</item>
    </style>






</resources>